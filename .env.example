# Supabase — project settings → API. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Project Settings → API Keys → secret key (sb_secret_…). Used by
# scripts/create-admin.mjs. Never prefix with NEXT_PUBLIC_. (Legacy
# SUPABASE_SERVICE_ROLE_KEY JWTs are accepted too.)
SUPABASE_SECRET_KEY=sb_secret_...

# Only for pushing migrations to the hosted project (supabase link / db push).
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=
